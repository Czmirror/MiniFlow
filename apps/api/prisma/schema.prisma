generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestStatus {
  Draft
  Pending
  Approved
  Rejected
  Deleted
}

model RequestRecord {
  id        String        @id @default(uuid()) @db.Uuid
  teamId    String
  createdBy String        @db.Uuid
  title     String
  body      String
  status    RequestStatus
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  approvals ApprovalRecord[]

  @@index([teamId, status, createdAt])
  @@map("requests")
}

model UserRecord {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  displayName  String?
  language     String   @default("ja")
  teamId       String   @default("team-1")
  role         String   @default("Applicant")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([teamId, role, isActive])
  @@map("users")
}

enum ApprovalActionType {
  Approved
  Rejected
}

model ApprovalRecord {
  id         String             @id @default(uuid()) @db.Uuid
  requestId  String             @db.Uuid
  actedBy    String             @db.Uuid
  actionType ApprovalActionType
  reason     String?
  createdAt  DateTime           @default(now())
  request    RequestRecord      @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("approvals")
}
